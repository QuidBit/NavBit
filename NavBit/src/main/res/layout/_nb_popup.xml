<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:elevation="4dp">

    <View
        android:id="@+id/_nb_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/_nb_popup_background"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/_nb_popup"
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/_nb_popup"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="8dp"
        android:outlineSpotShadowColor="@color/_nb_popup_shadow_edge"
        android:outlineAmbientShadowColor="@color/_nb_popup_shadow_edge"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/_nb_screen_sheet_popup_background">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/_nb_popup_content_area"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingVertical="16dp"/>

            <ImageView
                android:id="@+id/_nb_closeButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="4dp"
                android:layout_marginVertical="12dp"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:src="@drawable/_nb_ic_close"
                app:tint="@color/_nb_navigation_icons" />
        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>
</FrameLayout>